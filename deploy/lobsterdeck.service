[Unit]
Description=LobsterDeck API
After=network-online.target

[Service]
Type=simple
Environment=LOBSTERDECK_PORT=3320
Environment=LOBSTERDECK_STATE=/vol1/1000/Docker/LobsterDeck
WorkingDirectory=/vol1/1000/home/LiGuiyu/dev/LobsterDeck
ExecStart=/usr/bin/python3 server/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
